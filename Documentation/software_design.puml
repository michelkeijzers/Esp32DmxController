@startuml
title Architecture

legend right
    |= Color |= Meaning |
    |<back:LightYellow>               | RTOS Task |
    |<back:LightBlue>                | Data |
endlegend

class Main  
{
    extern "C" void app_main()
}

class RtosTask <<abstract>> #lightYellow 
{
    +RtosTask();
    +virtual ~RtosTask();

    +esp_err_t init(TaskProperties taskProperties);
    +virtual void taskEntry(void *param) = 0;
    +TaskHandle_t getTaskHandle() const
    +virtual QueueHandle_t getEventQueue() const
    +QueueHandle_t getDmxControllerEventQueue() const
    +const char *getTaskName() const
    +bool isInitialized() const

    -const char *task_name
    -const char *log_tag_
    -TaskHandle_t task_handle_
    -QueueHandle_t event_queue_
    -bool initialized_
    -QueueHandle_t main_event_queue_
}

class DmxController <<Task>> #LightYellow
{
    +DmxController(SevenSegmentDisplay *display, FootSwitch *footSwitch, \n Max3485Sender *dmx3485Sender, WebServer *webServer, NvStorage *nvStorage)
    +~DmxController()
    +virtual esp_err_t init()
    +void taskLoop()

    -esp_err_t init_sub_tasks()
    -esp_err_t init_messages()
    -esp_err_t performOtaUpdate(const char *url)
    -void printFirmwareInfo()

    -SevenSegmentDisplay *display_
    -FootSwitch *footSwitch_
    -Max3485Sender *max3485Sender_
    -WebServer *webServer_
    -NvStorage *nvStorage_
    
    -void taskEntry(void *param) override
}

Main -d-> DmxController
DmxController -|> RtosTask

class NvStorage #lightYellow {}
DmxController *-- NvStorage
NvStorage -u-|> RtosTask

class Max3485Sender #lightYellow {}
DmxController *- Max3485Sender
Max3485Sender -u-|> RtosTask

class FootSwitch #lightYellow {}
DmxController *-- FootSwitch
FootSwitch -u-|> RtosTask

class SevenSegmentDisplay #lightYellow {}
DmxController *-- SevenSegmentDisplay
SevenSegmentDisplay -u-|> RtosTask

class Ota #lightYellow {}
DmxController *-- Ota 
Ota -u-|> RtosTask

class WebServer #lightYellow {}
DmxController *-- WebServer
WebServer -u-|> RtosTask

'class OscHandler <<RtosTask>> #lightYellow {}
'DmxController *-- OscHandler

'class ArtNetSender <<RtosTask>> #lightYellow {}
'DmxController *-- ArtNetSender
'ArtNetSender --> DmxPreset : Read

class DmxPresets <<Data>> #lightBlue {}
DmxController *-- DmxPresets

class DmxPreset <<Data>> #lightBlue {}
DmxPresets *--"20" DmxPreset

class Configuration <<Data>> #lightBlue {}
DmxController *-- Configuration

NvStorage --> DmxPresets : Write
NvStorage --> Configuration : Write

'class OscConfiguration <<Data>> #grey {}
'Configuration *-- OscConfiguration
'OscHandler -- OscConfiguration : Read

FootSwitch -- Configuration : Read

WebServer --> DmxPresets : Read/ \n Write
WebServer --> Configuration : Read/ \n Write

Max3485Sender --> DmxPreset : Read
@enduml 

