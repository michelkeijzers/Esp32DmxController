@startuml 
title Init

actor User
participant Main
participant DmxController
participant WebServer
participant SevenSegmentDisplay
participant FootSwitch
participant NvStorage

Main -> DmxController : DmxController()
Main -> DmxController : init()
activate DmxController
    DmxController -> WebServer : WebServer()
    DmxController -> WebServer : init() 
    DmxController -> SevenSegmentDisplay: SevenSegmentDisplay()
    DmxController -> SevenSegmentDisplay : init()
    DmxController -> FootSwitch : FootSwitch()
    DmxController -> FootSwitch : init()
    DmxController -> NvStorage : NvStorage()
    DmxController -> NvStorage : init()
    DmxController --> NvStorage : LOAD_CONFIGURATION
deactivate DmxController

DmxController -> DmxController : taskLoop() 

activate DmxController
    NvStorage -> NvStorage : Load configuration \n from NVRAM and \n store in internal instance
    group Load Configuration
        alt Configuration loaded successfully from NVRAM
            NvStorage --> DmxController : UPDATE_CONFIGURATION
            DmxController -> NvStorage : Configuration get_configuration()
            NvStorage -> NvStorage : Take mutex
            NvStorage -> NvStorage : Copy configuration
            NvStorage -> NvStorage : Give mutex
            NvStorage --> DmxController : configuration instance
            DmxController --> FootSwitch : UPDATE_CONFIGURATION
            FootSwitch -> DmxController : GetConfiguration()
            DmxController -> DmxController : Take mutex
            DmxController -> DmxController : Copy configuration 
            DmxController -> DmxController : Release mutex
            DmxController --> FootSwitch : configuration instance
            FootSwitch -> FootSwitch : Copy to internal variables
            
        else error loading configuration from NVRAM 
            NvStorage --> DmxController : ERROR(NV_STORAGE_LOAD_CONFIGURATION_FAILED)
            DmxController --> SevenSegmentDisplay : DISPLAY_ERROR(\n NV_STORAGE_LOAD_CONFIGURATION_FAILED)
        end
    end

    DmxController --> NvStorage : LOAD_PRESETS
    loop each filled preset
        NvStorage -> NvStorage : Read preset part 1 from NVRAM
        NvStorage -> NvStorage : Read preset part 2 from NVRAM
    end

    note left of NvStorage
        In case of an error reading NVRAM, stop reading.
    end note

    group Load Presets (after NvStorage has loaded presets)
        note right of DmxController
            Similar flow as Load Configuration, but with presets instead of configuration.
        end note
    end
deactivate DmxController
@enduml 

@startuml
title Message Queues Next/Prev Preset

actor User
participant DmxController
participant FootSwitch
participant Max3485Sender
participant SevenSegmentDisplay

User -> FootSwitch : Short/Long
note right of FootSwitch
    Assuming a short press, resulting in a 
    SELECT_NEXT_PRESET message being sent to DmxController.
    Similar flow for SELECT_PREVIOUS_PRESET.
end note
FootSwitch --> DmxController : SELECT_NEXT_PRESET
DmxController -> DmxController : Update current preset index

DmxController --> Max3485Sender : UPDATE_PRESET
Max3485Sender -> DmxController : copy_current_dmx_data_into(DmxPreset* )
DmxController -> DmxController : Take mutex
DmxController -> DmxController : Copy DMX data to DmxPreset instance
DmxController -> DmxController : Release mutex
DmxController -> Max3485Sender : Filled DmxPreset instance

DmxController --> SevenSegmentDisplay : UPDATE_PRESET
SevenSegmentDisplay -> DmxController : get_current_preset_index()
DmxController -> DmxController : Take mutex
DmxController -> DmxController : Get current preset index
DmxController -> DmxController : Release mutex
DmxController --> SevenSegmentDisplay : current preset index
SevenSegmentDisplay -> SevenSegmentDisplay : Internal handling
@enduml

@startuml
title Webserver Update Config/Presets

user -> WebServer : Transmit new \n configuration/presets
WebServer --> DmxController : STORE_CONFIGURATION
DmxController -> DmxController : Copy to internal configuration
DmxController --> NvStorage : STORE_CONFIGURATION
NvStorage -> DmxController : get_configuration()
DmxController -> DmxController : Take mutex
DmxController -> DmxController : Copy configuration
DmxController -> DmxController : Release mutex
DmxController --> NvStorage : configuration
NvStorage -> NvStorage : Store configuration in NVRAM

DmxController --> FootSwitch : SET_FOOT_SWITCH_CONFIGURATION (as Init)
DmxController --> OscSender : SET_OSC_CONFIGURATION (as Init)

WebServer --> DmxController : STORE_PRESETS
DmxController -> DmxController : Copy to internal presets
DmxController --> NvStorage : STORE_PRESETS
NvStorage -> DmxController : get_presets()
DmxController -> DmxController : Take mutex
DmxController -> DmxController : Copy presets
DmxController -> DmxController : Release mutex
DmxController --> NvStorage : presets

loop For each preset
    NvStorage -> NvStorage : Split preset into part 1 and part 2
    NvStorage -> NvStorage : Store preset part 1 in NVRAM
    alt Error storing preset part 1 in NVRAM
        NvStorage --> DmxController : ERROR(NV_STORAGE_STORE_PRESET_FAILED)
        DmxController --> SevenSegmentDisplay : DISPLAY_ERROR(NV_STORAGE_STORE_PRESET_FAILED)
    end
    NvStorage -> NvStorage : Store preset part 2 in NVRAM
    alt Error storing preset part 2 in NVRAM
        NvStorage --> DmxController : ERROR(NV_STORAGE_STORE_PRESET_FAILED)
        DmxController --> SevenSegmentDisplay : DISPLAY_ERROR(NV_STORAGE_STORE_PRESET_FAILED)
    end
end

ref over DmxController : Update Preset Data (as in Message Queues Next/Prev Preset)
@enduml

@startuml 
title OTA Update

participant WebServer
participant RTOS
participant DmxController
participant Ota
participant SevenSegmentDisplay

WebServer --> DmxController : START_OTA
DmxController --> Ota : START_OTA 
Ota -> Ota : Perform OTA update
alt OTA update successful
    Ota --> DmxController : OTA_SUCCESS
    DmxController -> DmxController : Handle termination if needed
    DmxController --> RTOS: Reset
else OTA update failed
    Ota --> DmxController : ERROR(OTA_UPDATE_FAILED)
    DmxController --> SevenSegmentDisplay : DISPLAY_ERROR(OTA_UPDATE_FAILED)
end
@enduml 
