{
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/Unittests/React"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleDirectories": [
      "node_modules",
      "ReactWebsite"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "babel": {
    "presets": [
      "@babel/preset-react"
    ]
  }
}
